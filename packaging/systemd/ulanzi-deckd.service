[Unit]
Description=Ulanzi Deck service
Documentation=https://github.com/Tyaaa-aa/Ulanzi-Deck-Linux
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.tyaaa_aa.UlanziDeck
ExecStart=%h/.local/bin/ulanzi-deckd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
