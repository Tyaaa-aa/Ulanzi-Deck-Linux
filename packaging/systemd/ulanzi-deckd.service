[Unit]
Description=Ulanzi Deck service
Documentation=https://github.com/Tyaaa-aa/Ulanzi-Deck-Linux
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.tyaaa_aa.UlanziDeck.Service
ExecStart=@BINDIR@/ulanzi-deckd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
# Exit code 3 means another instance already runs; retrying would not help.
RestartPreventExitStatus=3

[Install]
WantedBy=graphical-session.target
