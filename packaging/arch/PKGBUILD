# Maintainer: Tyaaa-aa <https://github.com/Tyaaa-aa>
pkgname=ulanzi-deck
pkgver=2.0.0
pkgrel=1
pkgdesc="Set up Ulanzi D200 and D200X stream decks (keys, dials, wide-screen widgets, OBS)"
arch=('x86_64' 'aarch64')
url="https://github.com/Tyaaa-aa/Ulanzi-Deck-Linux"
license=('MIT')
depends=('gtk4' 'libadwaita' 'dbus' 'systemd')
makedepends=('cargo')
optdepends=(
  'pipewire-pulse: switch audio outputs'
  'wireplumber: volume control and the volume overlay'
  'wl-clipboard: Type Text with characters a US keyboard lacks'
  'obs-studio: OBS actions and widget'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "Ulanzi-Deck-Linux-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "Ulanzi-Deck-Linux-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --bins
}

check() {
  cd "Ulanzi-Deck-Linux-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release -p ulanzi-proto -p ulanzi-core
}

package() {
  cd "Ulanzi-Deck-Linux-$pkgver"
  NO_BUILD=1 sh scripts/stage.sh /usr "$pkgdir"
}
