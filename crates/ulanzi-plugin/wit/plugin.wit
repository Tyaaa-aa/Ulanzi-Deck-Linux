package ulanzi:plugin@1.1.0;

interface types {
    variant payload { text(string), binary(list<u8>) }
    record http-request {
        method: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }
    record http-response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }
    enum log-level { debug, info, warn, error }
    /// The plugin's own connection status, shown next to the plugin in the app.
    enum status { ok, connecting, problem }
    /// One entry of a picker list (contract 1.1). `id` is what a setting or action param
    /// stores; `label` is what the user sees. `group` sorts it under a heading, `icon` is an
    /// icon name or a short text, `state` is live state shown dimmed next to it (for example "on").
    record item {
        id: string,
        label: string,
        subtitle: option<string>,
        group: option<string>,
        icon: option<string>,
        state: option<string>,
    }
}

/// Always available.
interface core {
    use types.{log-level, status};
    /// Fire `on-timer(id)` after `ms`; again every `ms` when `repeat`.
    set-timer: func(ms: u32, repeat: bool) -> u32;
    cancel-timer: func(id: u32);
    /// Live state; shown on keys as `{<plugin-id>.<key>}`.
    set-state: func(key: string, value: string);
    secret-get: func(key: string) -> option<string>;
    secret-set: func(key: string, value: string);
    secret-delete: func(key: string);
    set-status: func(status: status, message: string);
    log: func(level: log-level, message: string);
}

/// Needs `network` or `lan` permission. Calls return at once; results arrive as events.
interface net {
    use types.{payload, http-request};
    /// `ws://` or `wss://`. Then `on-open` or `on-closed`.
    ws-open: func(url: string) -> result<u32, string>;
    tcp-open: func(host: string, port: u16, tls: bool) -> result<u32, string>;
    send: func(socket: u32, data: payload) -> result<_, string>;
    close: func(socket: u32);
    /// Then `on-http(id, …)`.
    fetch: func(request: http-request) -> result<u32, string>;
}

/// Contract 1.0: what every plugin exports. The host binds this world.
world plugin-base {
    use types.{payload, http-response};
    import core;
    import net;
    /// Settings from `[plugins.<id>.settings]` as JSON. Called at start and when settings change.
    export init: func(settings: string) -> result<_, string>;
    /// `params` is the key's action params as JSON. An error is shown to the user.
    export on-action: func(action: string, params: string) -> result<_, string>;
    export on-open: func(socket: u32);
    export on-message: func(socket: u32, data: payload);
    export on-closed: func(socket: u32, reason: string);
    export on-http: func(request: u32, response: result<http-response, string>);
    export on-timer: func(timer: u32);
}

/// Contract 1.1: 1.0 plus picker lists. Plugins (the SDK) bind this world.
world plugin {
    include plugin-base;
    use types.{item};
    /// The entries of the picker `picker` (declared in `[[pickers]]`) that match `query` (what the
    /// user typed, `""` for everything), only those in `group` unless it is `""`. Answer from
    /// memory (what the plugin already knows), never wait for the network: the call has the same
    /// 500 ms budget as any other. An error (for example "not connected") is shown to the user.
    export list-items: func(picker: string, query: string, group: string) -> result<list<item>, string>;
}
